# Supabase API Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Coming Soon Mode:
# 'true'  = Public visitors will only see the Coming Soon page
# 'false' = Full e-commerce store is live
VITE_COMING_SOON=true

# Passcode to unlock live site preview (e.g. client or developer review)
# Default is 'lune2026'. Can also bypass using ?preview=lune2026 in the URL.
VITE_PREVIEW_PASSCODE=lune2026

# Optional Target Launch Date (ISO format for countdown clock)
VITE_LAUNCH_DATE=2026-11-15T00:00:00
